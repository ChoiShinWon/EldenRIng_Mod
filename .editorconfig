root = true

[*]
end_of_line = crlf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{h,hpp,inl,c,cpp}]
charset = utf-8-bom
indent_style = tab

[*.{cs}]
charset = utf-8-bom
indent_style = tab

[*.{json,yml,yaml,xml,ini}]
charset = utf-8
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false
